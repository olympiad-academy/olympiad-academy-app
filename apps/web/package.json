{
  "name": "@olympiad-academy-app/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "test:unit": "tsx --test test/*.test.ts",
    "test:e2e": "pnpm --dir ../.. run e2e:prepare:web && playwright test --config playwright.config.ts",
    "build": "vite build",
    "quality:quick": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test:unit && pnpm run build",
    "dev": "vite --host 0.0.0.0 --port ${WEB_PORT:-5173}"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@olympiad-academy-app/api-client": "workspace:^0.1.0",
    "@olympiad-academy-app/ui": "workspace:^0.1.0",
    "i18next": "^26.3.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.0.11"
  }
}
