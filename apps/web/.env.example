# Vite reads .env files from apps/web (no envDir override) — the workspace
# root .env belongs to the API and is loaded by its own loader; Vite never
# sees it. Copy this file to apps/web/.env to override the defaults.
#
# Auth backend selection (D5). String comparison is exact: "true" → in-memory
# MockAuthApi, "false" → real API via the /api dev proxy. Unset → mock in
# dev/E2E, real API in a production build.
VITE_API_MOCK=true
